package ui

import (
	"github.com/jomakori/tickerlight/internal/tickerdata"
)

// Layout renders the full document: shell, session panel, status chips, the
// funding badge and the active panel. The badge, the session line, both
// session chips and the caps chip all follow the engine's status snapshot;
// with no snapshot they keep the console's built-in paper-only wording.
templ Layout(v View) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Tickerlight · ops console ({ v.SourceLabel() }, { v.Funding() })</title>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/app.js" defer></script>
		</head>
		<body>
			<div class="shell">
				<aside class="side">
					<div class="brand" aria-hidden="true">Tickerlight <span>ops</span></div>
					@nav(v)
					<div class="sess" aria-label="Session">
						<span class="lbl">Session</span>
						<div>@armWord(14, v)</div>
						<div class="tx2">{ v.AccountLabel() }<br/>{ v.SourceLine() }</div>
					</div>
				</aside>
				<div class="main">
					<header class="top">
						@chips(v)
						<span class="disc" role="note">{ v.SourceBadge() }</span>
					</header>
					@ViewShell(v)
				</div>
			</div>
		</body>
	</html>
}

// ViewShell is the HTMX swap target: the whole <main> element is replaced on
// navigation so the URL, the visible panel and the nav state stay in sync.
templ ViewShell(v View) {
	<main id="view" data-tab={ v.Tab }>
		if v.Tab == TabJournal {
			@Journal(v.Journal())
		} else if v.Tab == TabCalibration {
			@Calibration(v.Calibration())
		} else if v.Tab == TabRisk {
			@Risk(v.RiskState())
		} else if v.Tab == TabPolicy {
			@Policy(v.Policy)
		} else {
			@Overview(v.Overview())
		}
	</main>
}

templ nav(v View) {
	<nav class="tabs" aria-label="Sections">
		for _, t := range Tabs {
			<a
				class="tablink"
				href={ templ.URL(tabURL(t.Key)) }
				hx-get={ tabURL(t.Key) }
				hx-target="#view"
				hx-select="#view"
				hx-swap="outerHTML"
				hx-push-url="true"
				aria-current={ currentPage(v.Tab == t.Key) }
			>
				<span class="tl">{ t.Label }</span>
			</a>
		}
	</nav>
}

templ chips(v View) {
	<div class="chip-k">
		<span class="lbl">Arming flag</span>
		<b>@armWord(15, v)</b>
	</div>
	<div class="chip-k">
		<span class="lbl">Kill switch</span>
		<b>@killStatus(15, v)</b>
	</div>
	{{ c := v.Caps() }}
	<div class="chip-k">
		<span class="lbl">Caps · 24h</span>
		<b class="nw">
			{ Pct(c.Util(), 0) }
			<span class="den" style="font-size:13px">{ c.ChipDen() }</span>
		</b>
		if c.Engine {
			<span class="tx2" style="font-size:10px">per-order { USD(c.PerOrder) }</span>
		}
	</div>
}

// armWord is the arming-flag wordmark. The flag follows the engine's status
// snapshot; with no snapshot — or a paper one — it reads DISARMED, because a
// console with no engine to read must not imply an armed session.
templ armWord(size int, v View) {
	if v.Kill() {
		<span class="gl" style={ wordStyle(size, "#FF5A5F") }>
			@Icon("bang", size) HALTED
		</span>
	} else if v.Armed() {
		<span class="gl" style={ wordStyle(size, "") }>
			@Icon("dot", size) ARMED
		</span>
	} else {
		<span class="gl tx2" style={ wordStyle(size, "") }>
			@Icon("ring", size) DISARMED
		</span>
	}
}

// killStatus is the kill-switch wordmark, read from the engine's snapshot. With
// no snapshot it reads RELEASED: absence of a kill signal is not evidence that
// trading is halted, so the chip states the switch's own reported position.
templ killStatus(size int, v View) {
	if v.Kill() {
		<span class="gl" style={ wordStyle(size, "#FF5A5F") }>
			@Icon("bang", size) ENGAGED
		</span>
	} else {
		<span class="gl" style={ wordStyle(size, "") }>
			@Icon("check", size) RELEASED
		</span>
	}
}

// Icon renders one glyph from the shared stroke set.
templ Icon(name string, size int) {
	<svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style={ iconStyle(size) }>
		@templ.Raw(icons[name])
	</svg>
}

// Badge is the per-outcome pill.
templ Badge(o tickerdata.Outcome) {
	<span class={ "bd", string(o.Meta().Kind) }>
		@Icon(o.Meta().Icon, 12)
		{ o.Meta().Label }
	</span>
}

// Spine is the four-segment stage strip shown in journal rows and detail.
templ Spine(o tickerdata.Outcome) {
	<span class="spine" role="img" aria-label={ joinStates(StageStates(o), ", ") } title={ joinStates(StageStates(o), " · ") }>
		for i := range StageStates(o) {
			if o.Meta().Stop < 0 || i < o.Meta().Stop {
				<i class="sg pf"></i>
			} else if i == o.Meta().Stop && o.Meta().Kind == tickerdata.KindBad {
				<i class="sg xr"></i>
			} else if i == o.Meta().Stop {
				<i class="sg xb"></i>
			} else {
				<i class="sg"></i>
			}
		}
	</span>
}

// TicksMeter is the segmented utilisation meter with an ARIA meter wrapper.
templ TicksMeter(p float64, n int, label, max, now string) {
	<div role="meter" aria-label={ label } aria-valuemin="0" aria-valuemax={ max } aria-valuenow={ now }>
		@templ.Raw(Ticks(p, n))
	</div>
}
