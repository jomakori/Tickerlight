package ui

// NotFound is the standalone 404 document. It keeps the paper-only banner so a
// typo never lands the reader on a page that looks like live trading.
templ NotFound() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Not found · Tickerlight</title>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			<div class="shell">
				<aside class="side">
					<div class="brand" aria-hidden="true">Tickerlight <span>ops</span></div>
				</aside>
				<div class="main">
					<header class="top">
						<span class="disc" role="note">Sample data · paper only</span>
					</header>
					<main id="view">
						<section class="grid" aria-label="Not found">
							<div class="card c12">
								<h2>No such page</h2>
								<p class="tx2" style="margin:0 0 16px">
									The console has four sections: overview, journal, calibration and risk.
								</p>
								<a class="btn sm" href="/">Back to overview</a>
							</div>
						</section>
					</main>
				</div>
			</div>
		</body>
	</html>
}
