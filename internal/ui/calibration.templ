package ui

import (
	"strconv"

)

// Calibration compares the judge's stated probabilities with realized win
// rates, and makes the minimum-sample rule visible instead of implied.
templ Calibration(d CalibrationData) {
	<section class="grid" aria-label="Calibration">
		<div class="card c12">
			<div class="row">
				<h2>Calibration <span class="nd">· judge ≥ { Pct(d.Limits.JudgeMin, 0) } · minimum n { strconv.Itoa(d.MinN) }</span></h2>
				<span class="tx2">{ strconv.Itoa(d.Sample) } judge calls · { strconv.Itoa(d.MeetsN) } of { strconv.Itoa(len(d.Rows)) } buckets meet the floor</span>
			</div>
			<div class="mini four">
				<div><span class="lbl">Judge calls</span><span class="num n32">{ strconv.Itoa(d.Sample) }</span></div>
				<div><span class="lbl">Realized win rate</span><span class="num n32">{ Pct(d.WinRate(), 1) }</span></div>
				<div><span class="lbl">Mean stated p</span><span class="num n32">{ Pct(d.MeanStated(), 1) }</span></div>
				<div><span class="lbl">Buckets under floor</span><span class="num n32">{ strconv.Itoa(len(d.Rows) - d.MeetsN) }</span></div>
			</div>
			<div class="chart-box" data-chart>@templ.Raw(CalibrationChart(d.Buckets, d.Limits))</div>
			<p class="tx2" style="margin:12px 0 0">
				Dots are realized win rate per probability bucket; the dashed diagonal is perfect calibration. A bucket with n below the floor is drawn hatched and cannot promote anything.
			</p>
		</div>

		<div class="card c12">
			<h2>Buckets</h2>
			<div class="scroll">
				<table class="tbl">
					<thead>
						<tr>
							<th>Bucket</th>
							<th class="r">n</th>
							<th class="r">Wins</th>
							<th class="r">Win rate</th>
							<th class="r">Stated p</th>
							<th class="r">Delta</th>
							<th>Verdict</th>
						</tr>
					</thead>
					<tbody>
						for _, b := range d.Rows {
							<tr class={ templ.KV("dim", b.Low) }>
								<td class="mono">{ b.Label }</td>
								<td class="r mono">{ strconv.Itoa(b.N) }</td>
								<td class="r mono">{ strconv.Itoa(b.Wins) }</td>
								<td class="r mono">{ Pct(b.Rate, 0) }</td>
								<td class="r mono">{ Pct(b.Stated, 0) }</td>
								<td class={ "r mono", templ.KV("neg", b.Delta < 0) }>{ Pct(b.Delta, 0) }</td>
								<td>
									if b.Low {
										<span class="bd blk">@Icon("hourglass", 12) Low sample</span>
									} else if b.Delta < -0.07 {
										<span class="bd bad">@Icon("bang", 12) Overconfident</span>
									} else {
										<span class="bd ok">@Icon("check", 12) Within band</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<p class="tx2" style="margin:12px 0 0">
				Win rate is realized fills over bucket n. Stated p is the bucket midpoint, the value the judge claimed when it opened the trade.
			</p>
		</div>
	</section>
}

// WinRate is the overall realized win rate across the calibration sample.
func (d CalibrationData) WinRate() float64 {
	if d.Sample == 0 {
		return 0
	}
	return float64(d.Wins) / float64(d.Sample)
}

// MeanStated is the n-weighted mean stated probability.
func (d CalibrationData) MeanStated() float64 {
	if d.Sample == 0 {
		return 0
	}
	var sum float64
	for _, b := range d.Rows {
		sum += b.Stated * float64(b.N)
	}
	return sum / float64(d.Sample)
}
